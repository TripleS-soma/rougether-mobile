{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "environment": "development",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      },
      "ios": {
        "cocoapods": "1.17.0"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "dev",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      },
      "ios": {
        "cocoapods": "1.17.0"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      },
      "ios": {
        "cocoapods": "1.17.0"
      }
    },
    "testflight": {
      "autoIncrement": true,
      "channel": "dev",
      "ios": {
        "distribution": "store",
        "cocoapods": "1.17.0"
      },
      "environment": "preview",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6793513720"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "alpha"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6793513720",
        "ascApiKeyId": "6G2698ZUCN",
        "ascApiKeyIssuerId": "371e21a1-aa0c-4582-938e-005de68485b5",
        "ascApiKeyPath": "./asc-api-key.p8"
      }
    }
  }
}
