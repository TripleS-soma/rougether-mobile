# Shared dev/preview environment. EXPO_PUBLIC_* values are inlined into the JS
# bundle at build/export time (expo start, eas update, eas build all read this
# file). Store builds override these via EAS environment variables — never point
# production at the shared dev server.
EXPO_PUBLIC_API_URL=https://d12w5t2ftuhgj8.cloudfront.net/api/v1
EXPO_PUBLIC_ASSET_URL=https://rougether-assets.s3.ap-northeast-2.amazonaws.com
