{
  "expo": {
    "name": "Rougether",
    "slug": "rougether-mobile",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rougether",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.triples.rougether",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#FEF1D6"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.triples.rougether",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NanumSquareRoundR.ttf",
            "./assets/fonts/NanumSquareRoundB.ttf",
            "./assets/fonts/NanumSquareRoundEB.ttf",
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf",
            "./assets/fonts/Jua-Regular.ttf",
            "./assets/fonts/SUIT-Regular.otf",
            "./assets/fonts/SUIT-Medium.otf",
            "./assets/fonts/SUIT-SemiBold.otf",
            "./assets/fonts/SUIT-Bold.otf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEF1D6",
          "image": "./assets/images/icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#243273"
          },
          "ios": {
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover",
            "image": "./assets/images/splash-light.png",
            "dark": {
              "image": "./assets/images/splash-dark.png",
              "backgroundColor": "#243273"
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "루틴 인증 사진을 촬영하기 위해 카메라를 사용합니다.",
          "photosPermission": "루틴 인증 사진을 앨범에서 선택하기 위해 사진 접근 권한을 사용합니다.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#7FA87F",
          "defaultChannel": "default"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "루틴 인증 사진을 촬영하기 위해 카메라를 사용합니다.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "방 사진을 앨범에서 불러오기 위해 사진 접근 권한을 사용합니다.",
          "savePhotosPermission": "방 사진을 앨범에 저장하기 위해 사진 추가 권한을 사용합니다."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "extraMavenRepos": ["https://devrepo.kakao.com/nexus/content/groups/public/"]
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/crashlytics",
      "./plugins/with-fcm-channel-manifest-fix.js",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.499923665503-b1brsuooa940tjrs8vapo4dl2m8mri19"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "51365df21c97a355d92bc098e7677d3f",
          "android": {
            "authCodeHandlerActivity": true
          },
          "ios": {
            "handleKakaoOpenUrl": true
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RougetherToday",
              "label": "루게더 오늘의 루틴",
              "description": "오늘 진행도와 남은 루틴을 한눈에",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "RougetherRoom",
              "label": "루게더 내 방",
              "description": "꾸민 방과 오늘 진행도",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "430c1f3b-4035-47c8-9864-8e07687d628c"
      }
    },
    "owner": "evan7484",
    "updates": {
      "url": "https://u.expo.dev/430c1f3b-4035-47c8-9864-8e07687d628c"
    }
  }
}
