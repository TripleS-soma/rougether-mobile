{
  "expo": {
    "name": "Rougether",
    "slug": "rougether-mobile",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rougether",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.triples.rougether",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.triples.rougether",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NanumSquareRoundR.ttf",
            "./assets/fonts/NanumSquareRoundB.ttf",
            "./assets/fonts/NanumSquareRoundEB.ttf",
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf",
            "./assets/fonts/Jua-Regular.ttf",
            "./assets/fonts/SUIT-Regular.otf",
            "./assets/fonts/SUIT-Medium.otf",
            "./assets/fonts/SUIT-SemiBold.otf",
            "./assets/fonts/SUIT-Bold.otf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF0D8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "루틴 인증 사진을 촬영하기 위해 카메라를 사용합니다.",
          "photosPermission": "루틴 인증 사진을 앨범에서 선택하기 위해 사진 접근 권한을 사용합니다."
        }
      ],
      "expo-asset",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#7FA87F",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "루틴 인증 사진을 촬영하기 위해 카메라를 사용합니다."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/with-fcm-channel-manifest-fix.js",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.499923665503-b1brsuooa940tjrs8vapo4dl2m8mri19"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "430c1f3b-4035-47c8-9864-8e07687d628c"
      }
    },
    "owner": "evan7484",
    "updates": {
      "url": "https://u.expo.dev/430c1f3b-4035-47c8-9864-8e07687d628c"
    }
  }
}
