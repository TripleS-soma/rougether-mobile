{
  "expo": {
    "name": "Rougether",
    "slug": "rougether-mobile",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rougether",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.rougethermobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.rougethermobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "루틴 인증 사진을 촬영하기 위해 카메라를 사용합니다.",
          "photosPermission": "루틴 인증 사진을 앨범에서 선택하기 위해 사진 접근 권한을 사용합니다."
        }
      ],
      "expo-asset",
      "expo-audio",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "루틴 인증 사진을 촬영하기 위해 카메라를 사용합니다."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "430c1f3b-4035-47c8-9864-8e07687d628c"
      }
    },
    "owner": "evan7484",
    "updates": {
      "url": "https://u.expo.dev/430c1f3b-4035-47c8-9864-8e07687d628c"
    }
  }
}
