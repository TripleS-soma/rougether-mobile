{
  "expo": {
    "name": "Rougether",
    "slug": "rougether-mobile",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rougether",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.triples.rougether",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.triples.rougether"]
      }
    },
    "android": {
      "_comment_blockedPermissions": "카메라·마이크는 어느 기능도 쓰지 않는다 (#752). expo-image-picker는 앨범 선택만, expo-audio는 재생만 쓰는데 두 라이브러리가 자기 매니페스트에 CAMERA·RECORD_AUDIO를 선언해 스토어 목록에 '카메라'·'마이크'로 노출된다 — 병합 단계에서 제거한다.",
      "blockedPermissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#FEF1D6",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.triples.rougether",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NanumSquareRoundR.ttf",
            "./assets/fonts/NanumSquareRoundB.ttf",
            "./assets/fonts/NanumSquareRoundEB.ttf",
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf",
            "./assets/fonts/Jua-Regular.ttf",
            "./assets/fonts/SUIT-Regular.otf",
            "./assets/fonts/SUIT-Medium.otf",
            "./assets/fonts/SUIT-SemiBold.otf",
            "./assets/fonts/SUIT-Bold.otf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEF1D6",
          "image": "./assets/images/icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#243273"
          },
          "ios": {
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover",
            "image": "./assets/images/splash-light.png",
            "dark": {
              "image": "./assets/images/splash-dark.png",
              "backgroundColor": "#243273"
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "버그 제보에 첨부할 스크린샷을 앨범에서 선택하기 위해 사진 접근 권한을 사용합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7FA87F",
          "defaultChannel": "default"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "방 사진을 앨범에서 불러오기 위해 사진 접근 권한을 사용합니다.",
          "savePhotosPermission": "방 사진을 앨범에 저장하기 위해 사진 추가 권한을 사용합니다."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": ["https://devrepo.kakao.com/nexus/content/groups/public/"]
          },
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.4"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/with-fcm-manifest.js",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.499923665503-b1brsuooa940tjrs8vapo4dl2m8mri19"
        }
      ],
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "51365df21c97a355d92bc098e7677d3f",
          "android": {
            "authCodeHandlerActivity": true
          },
          "ios": {
            "handleKakaoOpenUrl": true
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RougetherToday",
              "label": "루게더 오늘의 루틴",
              "description": "오늘 진행도와 남은 루틴을 한눈에",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "RougetherRoom",
              "label": "루게더 내 방",
              "description": "꾸민 방과 오늘 진행도",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "appleTeamId": "2CAPC352DD"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "triples",
          "project": "rougether-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "430c1f3b-4035-47c8-9864-8e07687d628c"
      }
    },
    "owner": "evan7484",
    "updates": {
      "url": "https://u.expo.dev/430c1f3b-4035-47c8-9864-8e07687d628c"
    },
    "locales": {
      "ko": "./locales/ko.json"
    }
  }
}
